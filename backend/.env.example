# Copy to .env and change for production. Never commit the real file.
PORT=4000
NODE_ENV=development
# Long random string, at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Origin of the web app (used for CORS and Socket.IO)
WEB_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/saathverse.db
# Token required to read the analytics summary endpoint
ADMIN_TOKEN=change-me
# Only for local end to end tests. Has no effect when NODE_ENV=production.
# RATE_LIMITS=off
# Code required to create an admin account from /signup?as=admin. Change it.
ADMIN_INVITE_CODE=SAATH-ADMIN-2026
# One click demo accounts on the sign in page. Set to off for a real launch.
DEMO_LOGIN=on
# Fill an empty database with demo people on start. Set to off for a real launch.
SEED_DEMO=on
